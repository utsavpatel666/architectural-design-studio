# ============================================================
# Copy this file to ".env" and fill in your own values.
# NEVER put real passwords or secrets in this example file.
# NEVER commit the real ".env" file to git.
# On the live host, enter these as environment variables in the
# host's dashboard instead of uploading a file.
# ============================================================

# ---------- Server ----------
# The host usually sets PORT itself. Keep 5000 for local work.
PORT=5000
NODE_ENV=development
# Local:      NODE_ENV=development
# Live site:  NODE_ENV=production

# Set to your real site address (only if the code uses it)
# CLIENT_URL=https://your-domain.com

# Websites allowed to call the API, separated by commas.
# Local:
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000
# Live site (use your real domain, remove the local ones):
# CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

# ---------- Database (PostgreSQL) ----------
# Local example:
# DATABASE_URL=postgresql://postgres:your_local_password@localhost:5432/your_db_name
# Cloud example (Neon, Supabase, DigitalOcean, etc.):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ---------- Secrets ----------
# Make each one a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value for each.
JWT_SECRET=paste_generated_secret_1_here
SESSION_SECRET=paste_generated_secret_2_here

# ---------- Admin login (/admin.html) ----------
# Choose your own username (not "admin") and a strong password (16+ characters).
ADMIN_USERNAME=choose_a_username
ADMIN_PASSWORD=choose_a_strong_password

# ---------- Email (used to reply to enquiries) ----------
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as EMAIL_PASS.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=studio_email@example.com
EMAIL_PASS=your_app_password
NOTIFY_EMAIL=studio_email@example.com

# ---------- Contact info shown on the site ----------
# Optional: these can also be edited later in the admin Settings page.
BUSINESS_WHATSAPP=+919999999999
BUSINESS_INSTAGRAM=https://instagram.com/your_page

# ---------- Google sign-in (NOT needed) ----------
# Only for the optional "Sign in with Google" feature, which this site
# does not use. Leave these out unless the code refuses to start without them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=